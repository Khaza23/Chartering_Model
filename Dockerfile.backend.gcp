# GCP-optimized backend for Cloud Run (Prophet needs a compiler; PORT required)
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8080

WORKDIR /app

# Prophet/XGBoost build deps (cleaned in same layer to keep image small)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ make \
 && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

EXPOSE 8080

# Cloud Run injects $PORT; single uvicorn worker keeps RAM low on scale-to-zero
CMD exec uvicorn main:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1
