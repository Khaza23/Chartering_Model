# $0 live-data keys (all free registration, no credit card). Copy to .env
# FRED: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_KEY=
# EIA: https://www.eia.gov/opendata/register.php
EIA_KEY=
# Stooq: https://stooq.com/q/d/?s=bdi (get free API key via CAPTCHA form)
STOOQ_KEY=
# AISStream.io: login with GitHub at https://aisstream.io/account
AISSTREAM_KEY=
# Optional tuning (defaults are sane)
# BDI_REFERENCE=1500
# BDI_SENSITIVITY=0.006
# BUNKER_BASE_VLSFO=590
# BUNKER_BASE_MGO=760
# Sync behavior
SYNC_ON_BOOT=true
SYNC_DAILY=true
DATABASE_URL=
